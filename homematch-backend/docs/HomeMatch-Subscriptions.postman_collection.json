{
  "info": {
    "name": "HomeMatch Subscriptions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manual/simulation membership flow. Real payments stay disabled until Admin configures actual receiving details. Read SUBSCRIPTIONS.md."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "sellerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "sellerEmail",
      "value": ""
    },
    {
      "key": "sellerPassword",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "orderKey",
      "value": ""
    },
    {
      "key": "planId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Seller Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{sellerEmail}}\",\n  \"password\": \"{{sellerPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('sellerToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Public Plans",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/subscriptions/plans"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Plans available', () => pm.response.to.have.status(200));",
              "const plan = pm.response.json().plans?.find(p => p.code === 'premium'); if (plan) pm.collectionVariables.set('planId', plan._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Current Membership",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/subscriptions/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Listing Usage",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/subscriptions/usage",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Membership History",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/subscriptions/history?page=1&limit=20",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Analytics (Premium/Pro)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/subscriptions/analytics",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Admin Enable Simulation (NO real money)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/subscriptions/payment-settings",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enabled\": true,\n  \"mode\": \"simulation\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create Premium Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{orderKey}}"
          }
        ],
        "url": "{{baseUrl}}/subscriptions/subscribe",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"planCode\": \"premium\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('orderKey')) pm.collectionVariables.set('orderKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order created or replayed', () => pm.expect([200,201]).to.include(pm.response.code));",
              "if ([200,201].includes(pm.response.code)) pm.collectionVariables.set('paymentId', pm.response.json().payment._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Submit Evidence (choose slip file)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/subscriptions/payments",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "paymentId",
              "value": "{{paymentId}}",
              "type": "text"
            },
            {
              "key": "slip",
              "type": "file",
              "src": []
            }
          ]
        }
      }
    },
    {
      "name": "Order Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/subscriptions/payments/{{paymentId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Authenticated Slip",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/subscriptions/payments/{{paymentId}}/slip",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Admin Pending Payments",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/subscriptions/payments?status=pending&page=1",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Admin Approve (repeat returns 409)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/subscriptions/payments/{{paymentId}}/approve",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Admin Reject (use a different pending order)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/subscriptions/payments/{{paymentId}}/reject",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"หลักฐานไม่ตรงกับรายการโอนที่ตรวจสอบ\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Admin Members and History",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/subscriptions/members?page=1",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Admin Revenue (real/simulation separated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/subscriptions/revenue",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Admin All Plans",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/subscriptions/plans",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Admin Payment Settings",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/subscriptions/payment-settings",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Tampered Price Must Fail",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "invalid-price-test"
          }
        ],
        "url": "{{baseUrl}}/subscriptions/subscribe",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"planCode\": \"premium\",\n  \"priceSatang\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Tampering rejected', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Seller Cannot Approve",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/subscriptions/payments/{{paymentId}}/approve",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{sellerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Seller forbidden', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    }
  ]
}
